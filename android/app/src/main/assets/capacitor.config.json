{
	"appId": "com.customers.fastcalories.app",
	"appName": "Fast Calories",
	"webDir": "dist",
	"plugins": {
		"PushNotifications": {
			"presentationOptions": [
				"alert",
				"sound",
				"badge"
			]
		},
		"SplashScreen": {
			"launchAutoHide": false,
			"launchShowDuration": 0,
			"backgroundColor": "#f0fdf4",
			"showSpinner": false
		}
	},
	"ios": {
		"contentInset": "always"
	},
	"android": {
		"allowMixedContent": false,
		"captureInput": true,
		"webContentsDebuggingEnabled": false
	}
}
